{
  "name": "@oddsquad/vite-plugin-lit",
  "version": "0.2.3",
  "description": "Vite plugin providing true HMR for Lit components, plus CSS helpers and a DevTools panel",
  "license": "BSD-3-Clause",
  "author": "Oddsquad (based on @lit-labs/vite-hmr by Google LLC)",
  "type": "module",
  "main": "index.js",
  "module": "index.js",
  "files": [
    "/lib/",
    "/types/",
    "/panel/",
    "/index.{d.ts,d.ts.map,js,js.map}"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./css.js": {
      "types": "./lib/runtime/css.d.ts",
      "default": "./lib/runtime/css.js"
    }
  },
  "scripts": {
    "build": "tsc && node scripts/copy-panel-html.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "es-module-lexer": "^1.5.4",
    "launch-editor": "^2.10.0",
    "magic-string": "^0.30.11"
  },
  "peerDependencies": {
    "lightningcss": "^1.30.0",
    "lit": "^3.0.0",
    "vite": "^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "lightningcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
