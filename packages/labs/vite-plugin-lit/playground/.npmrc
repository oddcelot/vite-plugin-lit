# Standalone (StackBlitz/bolt.new) runs use Vite 7: Vite 8's rolldown
# wasm32-wasi binding currently crashes in WebContainers (Chrome 149+,
# see stackblitz/webcontainer-core#2104). The published plugin declares
# a vite ^8 peer; skip strict peer resolution until that range is
# widened or the upstream crash is fixed.
legacy-peer-deps=true
