# vite-plugin-lit playground configuration.
#
# Copy to `.env` (gitignored) and adjust. These are read at Vite *config* time
# by the plugin's own `config` hook: every litPlugin() option also resolves from
# a `LIT_PLUGIN`-prefixed env var. Explicitly-passed options win over env vars,
# which win over the built-in defaults. Values are strings; booleans "true"/"false".

# ── HMR ───────────────────────────────────────────────────────────────────────
# In-place HMR for Lit component classes. `false` disables patching AND the
# indicator below. Default: true
LIT_PLUGIN_HMR=true
# Cycle disconnected/connectedCallback on live instances after a patch. Default: false
LIT_PLUGIN_HMR_RECONNECT=false
# When a component can't be hot-patched in place: reload | warn. Default: reload
LIT_PLUGIN_HMR_ON_INCOMPATIBLE=reload

# ── HMR update indicator ──────────────────────────────────────────────────────
# Inject the on-page pulsing indicator (lit-devtools-hmr-indicator). Default: true
LIT_PLUGIN_HMR_INDICATOR=true
# Show a cumulative update count in the indicator pill. Default: false
LIT_PLUGIN_HMR_INDICATOR_COUNT=true

# ── Source overlay (click-to-open-in-IDE inspector) ───────────────────────────
# Enable the overlay. Toggle in-browser with Ctrl+Shift+<key>. Default: false
LIT_PLUGIN_SOURCE_OVERLAY=true
# Hotkey letter combined with Ctrl+Shift. Default: e
# Default key letter for the overlay toggle shortcut (Meta/Ctrl+Shift+<key>)
# LIT_PLUGIN_SOURCE_OVERLAY_KEY=e
# Editor for open-in-editor URLs: vscode | cursor | zed | idea | windsurf. Default: vscode
LIT_PLUGIN_SOURCE_OVERLAY_EDITOR=vscode
# Mouse-move throttle in ms. Default: 50
LIT_PLUGIN_SOURCE_OVERLAY_THROTTLE_MS=50

# ── Dev server ────────────────────────────────────────────────────────────────
# Playground dev server port. Default: 5179
LIT_PLUGIN_PLAYGROUND_PORT=5179
