{
  // This file is JSONC: fallow reads these comments; generic JSON tools may not.
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "src/index.{ts,tsx,js,jsx}",
    "src/main.{ts,tsx,js,jsx}",
    // Run by .github/workflows/release.yaml, not by a package.json script.
    "scripts/amo-metadata.mjs",
    // Run by hand when new docs screenshots land.
    "docs/scripts/place-shots.mjs"
  ],
  // lit/ is the upstream Lit submodule (canary builds only); assets/ holds the
  // HyperFrames promo-video projects; examples/tutorial/ is a set of files
  // copied over a `npm create vite` scaffold, not a project of its own.
  "ignorePatterns": ["lit/**", "assets/**", "examples/tutorial/**"],
  "ignoreDependencies": [
    // CI calls ./node_modules/.bin/jsr for the publish dry run.
    "jsr",
    // Pinned so StackBlitz finds the wasm binding; see pnpm-workspace.yaml.
    "rolldown",
    // The e2e fixtures serve playground sources from the repo root, so the
    // playground's temporal-polyfill import resolves from the root install.
    "temporal-polyfill"
  ],
  // Chrome DevTools frontend modules, imported inside the trace viewer page
  // by scripts/docs-shots.mjs.
  "ignoreUnresolvedImports": ["/devtools/**"],
  "workspaces": {
    "patterns": [
      "docs",
      "playground",
      "examples/flame",
      "examples/web-awesome",
      "examples/fernhouse"
    ]
  },
  "duplicates": {
    // Hide pair-only clones; focus on widespread copy-paste
    // worth refactoring. Lower to 2 to report every duplicate pair.
    "minOccurrences": 3,
    // Each playground demo and each example stands alone on purpose (they are
    // opened one at a time, often on StackBlitz), so their shared boilerplate
    // is not a refactoring target.
    "ignore": ["playground/**", "examples/**"]
  },
  "health": {
    // Build, release and docs tooling, demos and the benchmark harness: run by
    // hand or in CI, not shipped, and not where complexity costs us.
    "ignore": [
      "scripts/**",
      "bench/**",
      "docs/**",
      "playground/**",
      "examples/**",
      "*.config.ts",
      "extension/vite.config.ts"
    ],
    "thresholdOverrides": [
      {
        "files": ["src/panel/**"],
        "functions": ["render", "_renderDetails", "_renderNode", "_renderRow"],
        "maxCyclomatic": 30,
        "maxCognitive": 30,
        "reason": "Lit render methods: each `cond ? html`…` : nothing` in a template counts as a branch, so a readable template scores like tangled logic. Logic that isn't markup still belongs in a helper."
      }
    ]
  },
  // Complexity that predates fallow is recorded here; `fallow audit` and the
  // health check fail only on what is new.
  "audit": {
    "healthBaseline": "fallow-baselines/health.json"
  },
  "rules": {
    // Without coverage data fallow estimates CRAP from the module graph, which
    // flags well-tested code; report it but don't fail on it.
    "complexity-crap": "warn"
  }
}
