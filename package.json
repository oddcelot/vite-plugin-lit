{
  "name": "@oddsquad/vite-plugin-lit",
  "version": "0.2.3",
  "description": "Vite plugin providing true HMR for Lit components, plus CSS helpers and a DevTools panel",
  "license": "BSD-3-Clause",
  "author": "Oddsquad (based on @lit-labs/vite-hmr by Google LLC)",
  "type": "module",
  "main": "index.js",
  "module": "index.js",
  "files": [
    "/lib/",
    "/types/",
    "/panel/",
    "/index.{d.ts,d.ts.map,js,js.map}",
    "/client.d.ts"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./css.js": {
      "types": "./lib/runtime/css.d.ts",
      "default": "./lib/runtime/css.js"
    },
    "./client": {
      "types": "./client.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oddcelot/vite-plugin-lit.git"
  },
  "bugs": {
    "url": "https://github.com/oddcelot/vite-plugin-lit/issues"
  },
  "scripts": {
    "build": "tsc --pretty && node scripts/copy-panel-html.mjs && node scripts/format-build-output.mjs",
    "build:lit-canary": "node scripts/build-lit-canary.mjs",
    "dev": "pnpm run build && vp dev playground",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "vp test run --project unit",
    "test:e2e": "pnpm run build && vp test run --project e2e",
    "bench": "node bench/run.mjs",
    "bench:serve": "node bench/run.mjs --serve",
    "format": "vp fmt \"**/*.{cjs,html,js,json,md,ts,yaml}\"",
    "format:check": "vp fmt \"**/*.{cjs,html,js,json,md,ts,yaml}\" --check",
    "prepublishOnly": "pnpm exec vp check && pnpm run test:unit && pnpm run build",
    "prepare": "vp config"
  },
  "dependencies": {
    "es-module-lexer": "^3.0.2",
    "launch-editor": "^2.14.1",
    "magic-string": "^1.4.1"
  },
  "peerDependencies": {
    "lightningcss": "^1.30.0",
    "lit": "^3.0.0",
    "vite": "^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "lightningcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@lit-labs/signals": "^0.3.0",
    "@lit-labs/virtualizer": "^2.1.1",
    "@lit/context": "^1.1.6",
    "@lit/task": "^1.0.3",
    "@types/node": "^26.6.1",
    "lightningcss": "^1.33.0",
    "lit": "^3.3.3",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=20"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26"
    },
    "packageManager": {
      "name": "pnpm",
      "version": ">=12"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@12.3.4"
}
