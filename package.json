{
  "name": "@oddsquad/vite-plugin-lit",
  "version": "0.2.3",
  "description": "Vite plugin providing true HMR for Lit components, plus CSS helpers and a DevTools panel",
  "license": "BSD-3-Clause",
  "author": "Oddsquad (based on @lit-labs/vite-hmr by Google LLC)",
  "type": "module",
  "main": "index.js",
  "module": "index.js",
  "files": [
    "/lib/",
    "/types/",
    "/panel/",
    "/index.{d.ts,d.ts.map,js,js.map}",
    "/client.d.ts"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./css.js": {
      "types": "./lib/runtime/css.d.ts",
      "default": "./lib/runtime/css.js"
    },
    "./client": {
      "types": "./client.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oddcelot/vite-plugin-lit.git"
  },
  "bugs": {
    "url": "https://github.com/oddcelot/vite-plugin-lit/issues"
  },
  "scripts": {
    "build": "tsc --pretty && node scripts/copy-panel-html.mjs && prettier --write --ignore-path /dev/null \"index.js\" \"lib/**/*.js\"",
    "build:lit-canary": "node scripts/build-lit-canary.mjs",
    "dev": "pnpm run build && vite playground",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "bench": "node bench/run.mjs",
    "bench:serve": "node bench/run.mjs --serve",
    "format": "prettier \"**/*.{cjs,html,js,json,md,ts,yaml}\" --write",
    "format:check": "prettier \"**/*.{cjs,html,js,json,md,ts,yaml}\" --check",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "es-module-lexer": "^1.5.4",
    "launch-editor": "^2.10.0",
    "magic-string": "^0.30.11"
  },
  "peerDependencies": {
    "lightningcss": "^1.30.0",
    "lit": "^3.0.0",
    "vite": "^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "lightningcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@lit-labs/signals": "^0.3.0",
    "@lit-labs/virtualizer": "^2.1.1",
    "@lit/context": "^1.1.6",
    "@lit/task": "^1.0.3",
    "@types/node": "^26.0.0",
    "lightningcss": "^1.32.0",
    "lit": "^3.3.3",
    "playwright-core": "^1.60.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26"
    },
    "packageManager": {
      "name": "pnpm",
      "version": ">=12"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
