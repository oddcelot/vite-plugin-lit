---
/**
 * A screenshot with a light and a dark variant. Starlight's `light:sl-hidden`
 * and `dark:sl-hidden` utilities pick the one that matches the active theme,
 * so both images ship and the switch is CSS-only. Import the two PNGs from
 * `src/assets/shots/` and pass them in; Astro optimizes them at build.
 */
import {Image} from 'astro:assets';
import type {ImageMetadata} from 'astro';

interface Props {
  light: ImageMetadata;
  dark: ImageMetadata;
  alt: string;
  /** Rendered width in CSS pixels. Defaults to the image's intrinsic width / 2 (2x captures). */
  width?: number;
}

const {light, dark, alt, width} = Astro.props;
const w = width ?? Math.round(light.width / 2);
---

<figure class="themed-shot">
  <Image src={light} alt={alt} width={w} class="dark:sl-hidden" />
  <Image src={dark} alt={alt} width={w} class="light:sl-hidden" />
</figure>

<style>
  .themed-shot {
    margin: 1.5rem 0;
  }
  .themed-shot img {
    max-width: 100%;
    height: auto;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
  }
</style>
