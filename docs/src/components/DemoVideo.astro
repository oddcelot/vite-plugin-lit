---
/**
 * A short demo video from `public/demo/`. Muted autoplay on a loop, like a
 * moving screenshot; the controls are there to pause it or turn the music
 * on. Files in `public/` are not processed, so the paths carry the base.
 */
interface Props {
  /** What the video shows, for screen readers. */
  label: string;
  /** File stem in `public/demo/`: `<name>.mp4` and `<name>-poster.jpg`. */
  name?: string;
  width?: number;
  height?: number;
}

const {label, name = 'hmr-demo', width = 1440, height = 902} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<figure class="demo-video">
  <video
    src={`${base}/demo/${name}.mp4`}
    poster={`${base}/demo/${name}-poster.jpg`}
    width={width}
    height={height}
    aria-label={label}
    autoplay
    muted
    loop
    playsinline
    controls
    preload="metadata"></video>
</figure>

<style>
  .demo-video {
    margin: 1.5rem 0;
  }
  .demo-video video {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
  }
</style>
