---
/**
 * Starlight's LinkCard with a Phosphor icon before the title. LinkCard has no
 * icon slot, but it renders `title` as HTML, so the icon goes in there and
 * stays inside the link without copying LinkCard's markup.
 */
import {LinkCard} from '@astrojs/starlight/components';
import type {ComponentProps} from 'astro/types';
import {phosphor, type IconName} from '../lib/phosphor';

type Props = ComponentProps<typeof LinkCard> & {icon: IconName};

const {icon, title, ...rest} = Astro.props;
---

<LinkCard
  {...rest}
  title={`<span class="link-card-icon">${phosphor(icon, '1.25em')}</span>${title}`}
/>

<style>
  :global(.link-card-icon) {
    display: inline-flex;
    vertical-align: -0.2em;
    margin-inline-end: 0.5rem;
    color: var(--sl-color-text-accent);
  }
</style>
