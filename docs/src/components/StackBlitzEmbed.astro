---
/**
 * A directory of this repo running on StackBlitz, embedded in the page. Each
 * embed is a WebContainer that installs and starts a dev server, too heavy
 * to boot on scroll, so the iframe is only created on a click. StackBlitz's
 * `ctl=1` click-to-load does not apply to GitHub imports.
 *
 * The embed needs a cross-origin isolated page, which `coi-sw.js` provides
 * from the page's next load: the first Run reloads the page once, then
 * starts the embed. The caption has a button that reloads just the iframe,
 * next to a link that opens the project in a full StackBlitz tab.
 */
interface Props {
  /** Directory in the repo, such as `examples/flame`. */
  path: string;
  /** What the embed shows, for screen readers. */
  title: string;
  /** File open in the editor. */
  file?: string;
  /** npm script to run instead of the project's `startCommand`. */
  startScript?: string;
}

const {path, title, file, startScript} = Astro.props;

const project = `https://stackblitz.com/github/oddcelot/vite-plugin-lit/tree/main/${path}`;
const query = (extra: Record<string, string>) => {
  const params = new URLSearchParams(extra);
  if (file !== undefined) params.set('file', file);
  if (startScript !== undefined) params.set('startScript', startScript);
  const search = params.toString();
  return search === '' ? project : `${project}?${search}`;
};
---

<figure class="stackblitz-embed">
  <stackblitz-embed data-src={query({embed: '1', hideExplorer: '1'})}>
    <button type="button" class="run" data-title={title}>
      Run this demo
    </button>
  </stackblitz-embed>
  <figcaption>
    <button type="button" class="reload" hidden>
      Stuck? Reload the demo
    </button>
    <a href={query({})}>Open in StackBlitz</a>
  </figcaption>
</figure>

<script>
  // A WebContainer embed runs only on a cross-origin isolated page, in a
  // `credentialless` iframe; otherwise StackBlitz shows "Unable to run
  // Embedded Project". Only Chromium has `credentialless` iframes. The
  // isolation headers come from coi-sw.js, a service worker next to this
  // page, which takes effect from the next load of the page.
  const canEmbed =
    'credentialless' in HTMLIFrameElement.prototype &&
    'serviceWorker' in navigator;
  // The embed to start once the page comes back isolated.
  const PENDING = 'stackblitz-embed:pending';

  if (canEmbed) {
    void navigator.serviceWorker.register(
      `${import.meta.env.BASE_URL.replace(/\/$/, '')}/start/demos/coi-sw.js`,
    );
  }

  class StackBlitzEmbed extends HTMLElement {
    connectedCallback() {
      const run = this.querySelector<HTMLButtonElement>('.run');
      const reload =
        this.closest('figure')?.querySelector<HTMLButtonElement>('.reload');
      if (run === null || reload === null || reload === undefined) return;
      const src = this.dataset.src ?? '';

      const start = () => {
        const frame = document.createElement('iframe');
        frame.setAttribute('credentialless', '');
        frame.allow = 'cross-origin-isolated';
        frame.src = src;
        frame.title = run.dataset.title ?? '';
        run.replaceWith(frame);
        reload.hidden = false;
        reload.addEventListener('click', () => {
          frame.src = src;
        });
      };
      const unsupported = (text: string) => {
        const note = document.createElement('p');
        note.className = 'unsupported';
        note.textContent = text;
        run.replaceWith(note);
      };

      if (!canEmbed) {
        unsupported(
          'StackBlitz runs embedded demos only in Chromium-based browsers. Open this one in StackBlitz instead.',
        );
        return;
      }
      if (sessionStorage.getItem(PENDING) === src) {
        sessionStorage.removeItem(PENDING);
        // Reloaded for this embed; if the worker still did not isolate the
        // page, say so instead of reloading again.
        if (crossOriginIsolated) {
          start();
          this.scrollIntoView({block: 'center'});
        } else {
          unsupported(
            'This page could not enable the isolation the embed needs. Open this demo in StackBlitz instead.',
          );
        }
        return;
      }
      run.addEventListener('click', async () => {
        if (crossOriginIsolated) {
          start();
          return;
        }
        run.disabled = true;
        sessionStorage.setItem(PENDING, src);
        await navigator.serviceWorker.ready;
        location.reload();
      });
    }
  }
  customElements.define('stackblitz-embed', StackBlitzEmbed);
</script>

<style>
  .stackblitz-embed {
    margin: 1.5rem 0;
  }
  stackblitz-embed {
    display: grid;
    place-items: center;
    height: 32rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    overflow: hidden;
    background: var(--sl-color-gray-6);
  }
  stackblitz-embed :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
  }
  .run {
    padding: 0.5rem 1.25rem;
    border: 0;
    border-radius: 999rem;
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  stackblitz-embed :global(.unsupported) {
    max-width: 28rem;
    margin: 0;
    padding: 1rem;
    text-align: center;
  }
  .stackblitz-embed figcaption {
    display: flex;
    gap: 1rem;
    align-items: center;
    margin-top: 0.5rem;
    font-size: var(--sl-text-sm);
  }
  .reload {
    padding: 0;
    border: 0;
    background: none;
    color: var(--sl-color-text-accent);
    font: inherit;
    text-decoration: underline;
    cursor: pointer;
  }
</style>
